{
  "manifest_version": 3,
  "name": "درع السياق الاستباقي — Proactive Context Shield",
  "version": "1.1.0",
  "description": "فحص استباقي للروابط ونتائج البحث قبل فتحها: كشف المواقع المقلدة والاحتيال المالي قبل إدخال أي بيانات، مع وضع سحابة اختياري.",
  "default_locale": "ar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "درع السياق الاستباقي",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules/data.js", "rules/engine.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "interstitial/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
